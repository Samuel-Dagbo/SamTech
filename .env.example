# ─────────────────────────────────────────────────────────────
# SamTech Labs — environment configuration
# Copy to `.env.local` (never commit real values).
#
# PUBLIC  = safe to expose to the browser bundle.
# SERVER  = server-only secret; never referenced in client components.
# ─────────────────────────────────────────────────────────────

# SERVER · MongoDB Atlas connection string (SRV uri, includes db name).
# Get it from Atlas → Database → Connect → Drivers.
MONGODB_URI=

# SERVER · Application origin used for canonical URLs, sitemap and
# email links. Set the REAL production/preview origin per environment.
# Defaults to the current production domain when unset.
APP_URL=

# SERVER · Mailjet transactional email credentials (https://app.mailjet.com/account).
# Required for staff invitations (Phase 4); optional for contact notifications.
MAILJET_API_KEY=
MAILJET_API_SECRET=

# SERVER · Verified Mailjet sender identity (sender + name must already be
# verified in the Mailjet dashboard before production use).
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# SERVER · Pepper used when hashing session/invitation tokens in MongoDB.
# REQUIRED for authentication (login/workspace). Generate with: openssl rand -hex 32
SESSION_SECRET=

# SERVER · Optional: inbox address that receives contact-form notifications.
# Defaults to MAILJET_FROM_EMAIL when unset.
CONTACT_NOTIFY_EMAIL=
